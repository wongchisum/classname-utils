{
  "name": "classname-utils",
  "version": "0.0.1",
  "description": "A lightweight utility for generating class names with prefix, separator and context mapping",
  "keywords": [
    "classnames",
    "utils",
    "utility"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsup src/index.ts --onSuccess  \"npm run start\"",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "docs": "typedoc --out docs src",
    "build": "tsup src/index.ts --minify --format esm --dts",
    "bench": "tsup bench/index.ts --outDir output --onSuccess  \"node output/index.js\""
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@vitest/coverage-istanbul": "^3.2.4",
    "classnames": "^2.5.1",
    "tinybench": "^4.0.1",
    "tsup": "^8.5.0",
    "typedoc": "^0.28.5",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
